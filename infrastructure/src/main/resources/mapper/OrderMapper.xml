<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.sampleec.infrastructure.mapper.OrderMapper">

    <resultMap id="orderResultMap" type="com.example.sampleec.infrastructure.entity.OrderTableEntity">
        <id property="id" column="id"/>
        <result property="buyerId" column="buyer_id"/>
        <result property="totalPrice" column="total_price"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByBuyerId" resultMap="orderResultMap">
        SELECT id, buyer_id, total_price, status, created_at, updated_at
        FROM orders
        WHERE buyer_id = #{buyerId}
        ORDER BY created_at DESC
    </select>

    <insert id="insert" parameterType="com.example.sampleec.infrastructure.entity.OrderTableEntity">
        INSERT INTO orders (id, buyer_id, total_price, status, created_at, updated_at)
        VALUES (#{id}, #{buyerId}, #{totalPrice}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

</mapper>
